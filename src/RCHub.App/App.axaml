<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RCHub.App.App" RequestedThemeVariant="Light">
<Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="RchControl">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="RchBorder">#CBD7E6</SolidColorBrush><SolidColorBrush x:Key="RchText">#253349</SolidColorBrush><SolidColorBrush x:Key="RchHeader">#F3F7FC</SolidColorBrush><SolidColorBrush x:Key="RchMuted">#556981</SolidColorBrush></ResourceDictionary><ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="RchControl">#263445</SolidColorBrush><SolidColorBrush x:Key="RchBorder">#415168</SolidColorBrush><SolidColorBrush x:Key="RchText">#EDF2F9</SolidColorBrush><SolidColorBrush x:Key="RchHeader">#1D2938</SolidColorBrush><SolidColorBrush x:Key="RchMuted">#B8C9DD</SolidColorBrush></ResourceDictionary></ResourceDictionary.ThemeDictionaries></ResourceDictionary></Application.Resources>
<Application.Styles><FluentTheme/><StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
<Style Selector="Button"><Setter Property="Foreground" Value="{DynamicResource RchText}"/><Setter Property="Background" Value="{DynamicResource RchControl}"/><Setter Property="BorderBrush" Value="{DynamicResource RchBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,8"/></Style>
<Style Selector="Button.primary"><Setter Property="Background" Value="#195FD4"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#D8E3F3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,10"/></Style>
<Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource RchControl}"/><Setter Property="BorderBrush" Value="{DynamicResource RchBorder}"/><Setter Property="Foreground" Value="{DynamicResource RchText}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,8"/></Style>
<Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource RchControl}"/><Setter Property="BorderBrush" Value="{DynamicResource RchBorder}"/><Setter Property="Foreground" Value="{DynamicResource RchText}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,6"/></Style>
<Style Selector="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
<Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource RchHeader}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource RchMuted}"/><Setter Property="Padding" Value="10,12"/></Style>
<Style Selector="Expander"><Setter Property="Background" Value="{DynamicResource RchControl}"/><Setter Property="BorderBrush" Value="{DynamicResource RchBorder}"/><Setter Property="Foreground" Value="{DynamicResource RchText}"/></Style></Application.Styles></Application>
